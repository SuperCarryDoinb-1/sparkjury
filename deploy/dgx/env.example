# Copy to deploy/dgx/.env on the DGX node and `source` it (or `set -a; source deploy/dgx/.env; set +a`).
# Never commit the real file.

# ---- cloud keys (optional) ----------------------------------------------------
STEPFUN_API_KEY=            # judge_c (step-3.7-flash), required by the competition
TYPESAFE_API_KEY=           # Jev arbitration; empty -> local arbitration, marked degraded
SPARKJURY_API_TOKEN=        # protects the public API/cockpit on port 9000 (-> public 9030). Leave empty only on localhost.

# ---- model weights ---------------------------------------------------------------
MODELS_DIR=$HOME/models                     # team node already holds Qwen3.8-27B and Nemotron-3.5-Lightning-30B-A3B-NVFP4 here
JUDGE_A_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8   # FP8 (31 GB): the bf16 build (57 GB) OOM-killed the whole session next to Nemotron
JUDGE_B_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B-NVFP4   # preloaded on the team node; NVIDIA family, MoE NVFP4 (Gemma 4 12B is the alternative)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
AGENT_MODEL=Qwen/Qwen3-8B
HF_ENDPOINT=https://hf-mirror.com          # faster from China; or use modelscope in download_models.sh

# ---- ports (all bound to 127.0.0.1; only the API is exposed) ---------------------
JUDGE_A_PORT=8001
JUDGE_B_PORT=8002
EMBED_PORT=8003
AGENT_PORT=8004
API_PORT=9000                               # node 9000 -> public 9030 for spark node 80

# ---- memory split of the 128 GB unified memory (fractions passed to vLLM) --------
JUDGE_A_MEM=0.32
JUDGE_B_MEM=0.22
EMBED_MEM=0.03
AGENT_MEM=0.16
# sum 0.73 of 119 GB; leave >= 25 GB for page cache while weights load, or the OOM killer takes the session down
